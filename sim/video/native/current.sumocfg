<configuration>
    <input>
        <net-file value="../../../networks/BELAGERE.net.xml"/>
        <route-files value="../../demand-peak-baseline.rou.xml"/>
        <gui-settings-file value="gui-settings.xml"/>
    </input>
    <time><begin value="0"/><end value="3600"/><step-length value="1"/></time>
    <processing>
        <time-to-teleport value="300"/>
        <max-depart-delay value="1800"/>
    </processing>
    <random_number><seed value="42"/></random_number>
</configuration>
