# simo-player server env — dev values (copy to .env; never commit it).
# Load with: set -a; . ./.env; set +a; npm start
#
# Postgres: system of record for wizard submissions (sim metadata + upload
# refs). Discrete PG* vars, NO code defaults — the server fails fast
# listing missing vars at startup.
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=simo_player
# DATABASE_URL / SIMO_DATABASE_URL override the PG* vars wholesale when set
# (e.g. DATABASE_URL=postgresql://user:pass@host:5432/simo_player)

# S3-compatible bucket holding the uploaded XML bytes (private — downloads
# are proxied by the server, creds never leave the process).
# SIMO_S3_ENDPOINT empty -> AWS S3; set it for MinIO (path-style forced).
# Dev alternative: set SIMO_BUCKET_DISK_DIR to a local directory and the
# server stores the bytes on disk instead (no SIMO_S3_* needed; the dir
# wins over SIMO_S3_* when both are set).
#SIMO_BUCKET_DISK_DIR=.simo-uploads
SIMO_S3_ENDPOINT=
SIMO_S3_REGION=us-east-1
SIMO_S3_BUCKET=simo-uploads-dev
SIMO_S3_ACCESS_KEY_ID=minioadmin
SIMO_S3_SECRET_ACCESS_KEY=minioadmin

# Firebase Google sign-in: POST /api/simulate requires a Firebase ID token,
# verified server-side by firebase-admin. Set this to the BASE64 of a
# service-account JSON (Firebase console -> Project settings -> Service
# accounts -> Generate new private key), not a file path:
#   base64 -i firebase-service-account.json | tr -d '\n'
# Discrete var, NO code default — the server fails fast listing it at
# startup, like the PG* vars above, and rejects values that don't decode
# to a service-account JSON object.
GOOGLE_APPLICATION_CREDENTIALS=

# Review flow: comma-separated admin emails (case-insensitive) checked
# against the verified token claims.email. Unset/empty -> no admins (the
# server logs a warning; submissions stay pending and the review UI is
# hidden). A Firebase account without an email claim is never admin.
SIMO_ADMIN_EMAILS=

# Worker pool (POST /api/simulate + /api/export-net run their subprocesses
# in bounded slots): concurrent jobs cap, then FIFO queue cap. Defaults:
# cpus-1 (min 1) slots and 32 queued; a full queue answers 503 busy.
#SIMO_WORKER_COUNT=7
#SIMO_WORKER_QUEUE_MAX=32

# Per-job subprocess timeouts (ms): a simulate (pack_run) gets 5 min
# (SIMULATE_TIMEOUT_MS, not env-tunable), an area export (netconvert) gets
# 2 min by default; timeouts answer 504.
#SIMO_CONVERT_TIMEOUT_MS=120000