# simo-player server env — dev values (copy to .env; never commit it).
# Load with: set -a; . ./.env; set +a; npm start
#
# Postgres: system of record for wizard submissions (sim metadata + upload
# refs). Discrete PG* vars, NO code defaults — the server fails fast
# listing missing vars at startup.
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=simo_player
# DATABASE_URL / SIMO_DATABASE_URL override the PG* vars wholesale when set
# (e.g. DATABASE_URL=postgresql://user:pass@host:5432/simo_player)

# S3-compatible bucket holding the uploaded XML bytes (private — downloads
# are proxied by the server, creds never leave the process).
# SIMO_S3_ENDPOINT empty -> AWS S3; set it for MinIO (path-style forced).
SIMO_S3_ENDPOINT=
SIMO_S3_REGION=us-east-1
SIMO_S3_BUCKET=simo-uploads-dev
SIMO_S3_ACCESS_KEY_ID=minioadmin
SIMO_S3_SECRET_ACCESS_KEY=minioadmin